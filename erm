local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

-- Anti-AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- FPS cap
task.spawn(function()
    while true do
        pcall(function()
            setfpscap(10)
        end)
        task.wait(5)
    end
end)

-- Auto paycheck
getgenv().ReceberDin = true
task.spawn(function()
    while getgenv().ReceberDin == true do
        task.wait()
        pcall(function()
            workspace.Main.GivePaycheck:FireServer("Paycheck")
        end)
    end
end)

-- Remove Capsule prompt
task.spawn(function()
    pcall(function()
        local gui = LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainGui", 10)
        local prompts = gui and gui:WaitForChild("Prompts", 10)
        local capsule = prompts and prompts:FindFirstChild("Capsule")
        if capsule then
            capsule:Destroy()
        end
    end)
end)

-- Hide map parts + move job buttons
task.spawn(function()
    pcall(function()
        if not workspace:FindFirstChild("CDough") then
            local folder = Instance.new("Folder")
            folder.Name = "CDough"
            folder.Parent = workspace
            getgenv().Folder = folder
        end

        local keep = {
            Street = true,
            Street2 = true,
            Floor = true,
            BasePlate = true,
        }

        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Part") then
                v.Transparency = keep[v.Name] and 0 or 1
            end
        end

        for _ = 1, 3 do
            task.wait(1)
            for _, job in pairs(workspace.JobButtons:GetChildren()) do
                if job:IsA("Part") then
                    job.Position = Vector3.new(job.Position.X, -3, job.Position.Z)
                end
            end
        end
    end)
end)
